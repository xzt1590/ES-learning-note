### 1.12.5 merge() 方法 - 合并策略选择

```java
public void merge() throws IOException {
    // 获取 leading reader 的 PQ 信息
    JVectorReader leadingReader = getLeadingReader();
    Optional<ProductQuantization> existingPQ =
        leadingReader.getProductQuantizationForField(fieldName);

    // ========== 决定 PQ 策略 ==========
    PQVectors compactPqVectors;

    if (existingPQ.isEmpty()) {
        // 没有现有 PQ
        if (totalLiveVectorsCount >= minimumBatchSizeForQuantization) {
            // 向量够多，创建新的 PQ
            compactPqVectors = getPQVectors(compactRavv, fieldInfo);
        } else {
            // 向量太少，不使用 PQ
            compactPqVectors = null;
        }
    } else {
        // 有现有 PQ，用新向量精炼码本
        ProductQuantization pq = existingPQ.get();
        for (int i = 1; i < readers.length; i++) {
            pq.refine(readers[i].getFloatVectorValues(fieldName));
        }
        compactPqVectors = PQVectors.encodeAndBuild(pq, ...);
    }

    // ========== 决定图构建策略 ==========
    if (compactPqVectors == null) {
        // 无 PQ，尝试增量合并
        boolean ok = tryLeadingSegmentMerge();
        if (!ok) {
            // 增量合并失败，从头构建
            buildGraphFromScratch();
        }
    } else {
        // 有 PQ，必须从头构建（PQ 编码变了）
        buildGraphFromScratch();
    }
}
```

### 1.12.6 tryLeadingSegmentMerge() - 增量合并

```java
private boolean tryLeadingSegmentMerge() throws IOException {
    // ========== 检查是否可以增量合并 ==========

    // 1. 配置是否禁用
    if (leadingSegmentMergeDisabled) {
        return false;
    }

    // 2. 检查 ordinal 空间是否会溢出
    long heapOrdUpperBound = leadingGraphIdUpperBound + totalLiveVectorsInOtherReaders;
    if (heapOrdUpperBound > IndexWriter.MAX_DOCS) {
        log.warn("ordinal 空间可能溢出，跳过增量合并");
        return false;
    }

    // 3. 检查图的稀疏度（太多删除会导致 ordinal 稀疏）
    double density = totalLiveVectorsCount / (double) heapOrdUpperBound;
    if (density < MIN_HEAP_GRAPH_ORDINAL_DENSITY) {  // 0.4
        log.warn("图太稀疏 ({} < 0.4)，跳过增量合并", density);
        return false;
    }

    // ========== 执行增量合并 ==========

    // 1. 加载 leading segment 的图到内存
    OnHeapGraphIndex leadingGraph = OnHeapGraphIndex.load(
        leadingReader.getNeighborsScoreCacheForField(fieldName),
        dimension,
        degreeOverflow,
        diversityProvider
    );

    // 2. 创建图构建器，基于现有图
    GraphIndexBuilder builder = new GraphIndexBuilder(
        buildScoreProvider,
        dimension,
        leadingGraph,      // 传入现有图！
        beamWidth,
        degreeOverflow,
        alpha,
        true,
        SIMD_POOL_MERGE,
        PARALLELISM_POOL
    );

    // 3. 并行插入其他段的向量
    SIMD_POOL_MERGE.submit(() ->
        IntStream.range(leadingGraph.getIdUpperBound(), heapRavv.size())
            .parallel()
            .forEach(ord -> {
                builder.addGraphNode(ord, vv.get().getVector(ord));
            })
    ).join();

    // 4. 标记已删除的节点
    for (int i = 0; i < numBaseVectors; i++) {
        if (!liveGraphNodesPerReader[LEADING_READER_IDX].get(i)) {
            builder.markNodeDeleted(midToHeapOrds[i]);
        }
    }

    // 5. 清理图结构
    builder.cleanup();

    // 6. 写入磁盘
    writeField(fieldInfo, heapRavv, null, finalOrdToDocMap, graph);

    return true;
}
```

